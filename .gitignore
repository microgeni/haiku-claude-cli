# ---> C++
# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Project-specific
build/
build-release/
# Cross-compile trees (make ARCH=arm64 → build-arm64/, build-release-arm64/)
build-*-arm64/
build-arm64/
# Local Claude Code state is ignored, but project skills are shared —
# they document project-specific procedures and belong in the repo.
# (A bare ".claude/" would stop git descending, hence the /* + negation.)
.claude/*
!.claude/skills/

# Genio IDE workspace files
.genio.yaml
.genio-claude-selection.txt

*.tar
