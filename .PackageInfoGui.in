name			claude_gui
version			@VERSION@-@BUILD@
architecture		x86_64
summary			"Native Claude GUI for Haiku OS"
description		"Claude — a native BeAPI desktop client for the Anthropic Claude API on Haiku OS. Streaming markdown chat, tool use, BFS session storage, and a resizable three-pane layout."
packager		"Daniel Benjaminsson <info@microgeni.se>"
vendor			"Microgeni AB"
copyrights		"2026 Microgeni AB"
licenses		MIT
urls			"https://gitea.microgeni.synology.me/daniel/haiku-claude-cli"
provides {
	claude_gui = @VERSION@-@BUILD@
	app:Claude = @VERSION@-@BUILD@
}
requires {
	haiku >= r1~beta5
	lib:libcurl
	lib:libcrypto >= 3
	lib:libssl >= 3
	lib:libyaml_cpp
	lib:libbe
}
